# Copiar para .env e preencher com valores reais.
# Nunca comitar o .env real (já está no .gitignore).

# --- Ambiente ---
NODE_ENV=development
PORT=5000

# --- Base de dados (usar DATABASE_URL OU o conjunto DB_* abaixo) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false

# --- Autenticação (JWT) ---
JWT_SECRET=defina_uma_string_aleatoria_longa
JWT_EXPIRES_IN=12h
JWT_COOKIE_MAX_AGE_MS=

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=

# --- Email (obrigatório em produção, ou se EMAIL_REQUIRED=true) ---
EMAIL_REQUIRED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_ALLOW_SELF_SIGNED=false
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app
EMAIL_FROM=
APP_URL=http://localhost:5173

# --- Logo nos emails (opcional) ---
EMAIL_LOGO_URL=
EMAIL_LOGO_PUBLIC_ID=

# --- Cloudinary (upload de imagens de perfil, opcional mas tudo-ou-nada) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_LOGO_PUBLIC_ID=

# --- Firebase Admin (push notifications, opcional) ---
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Webhooks de mensagens/SMS (opcional) ---
MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- Tabela de autenticação customizável (opcional, defaults cobrem o caso comum) ---
# AUTH_TABLE=users
# AUTH_ID_COLUMN=id_user
# AUTH_EMAIL_COLUMN=email
# AUTH_PASSWORD_COLUMN=password
# AUTH_ROLE_COLUMN=role
# AUTH_STATUS_COLUMN=status
# AUTH_REQUIRE_ACTIVE=true
# AUTH_NAME_COLUMN=
# AUTH_IMAGE_COLUMN=
# AUTH_FIRST_LOGIN_COLUMN=

# --- Logging ---
ENABLE_REQUEST_LOGS=false
